{
  "name": "@zanny/svg-to-pdf",
  "version": "0.0.0",
  "description": "Browser-first SVG to PDF conversion helpers backed by WebAssembly.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/svg-to-pdf.js",
  "module": "./dist/svg-to-pdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/svg-to-pdf.js"
    },
    "./svg-to-pdf.wasm": "./dist/svg-to-pdf.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run copy-wasm",
    "copy-wasm": "node -e \"require('node:fs').copyFileSync('../../wasm/dist/svg-to-pdf.wasm', 'dist/svg-to-pdf.wasm')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  }
}
